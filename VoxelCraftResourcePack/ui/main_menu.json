    "layer": 20,
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [0, 36],
    "size": ["100%c", "100%c"]
  },

  "branding_overlay": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      { "branding_title@voxelcraft_branding.branding_title": {} },
      { "branding_subtitle@voxelcraft_branding.branding_subtitle": {} }
